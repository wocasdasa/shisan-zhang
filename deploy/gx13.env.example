# 复制到 /etc/gx13.env 后按实际改（nginx 反代方案）
PORT=8787
HOST=127.0.0.1
MAX_CONNS=400
MAX_ROOMS=200
# DEBUG=1

# 方案 B（Node 自己跑 TLS）才需要下面两行/四行
# TLS_KEY=/etc/letsencrypt/live/gx13.example.com/privkey.pem
# TLS_CERT=/etc/letsencrypt/live/gx13.example.com/fullchain.pem
# TLS_PFX=/opt/gx13/cert.pfx
# TLS_PASS=change-me
