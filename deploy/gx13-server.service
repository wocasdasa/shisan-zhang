[Unit]
Description=Guangxi 13 relay server (WebSocket)
After=network.target

[Service]
Type=simple
User=gx13
Group=gx13
WorkingDirectory=/opt/gx13
EnvironmentFile=/etc/gx13.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
LimitNOFILE=4096

# 只有「方案 B：Node 自己监听 443」时才需要下面这行（允许非 root 绑定低端口）
# AmbientCapabilities=CAP_NET_BIND_SERVICE

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
